# ctbz-code — variáveis de ambiente. Copie para .env e preencha.
# Carregue com:  set -a; source .env; set +a
# .env é ignorado pelo git; .env.example (este) é versionado.

# --- Auth Anthropic (escolha UMA; se nenhuma, cai em ~/.claude/.credentials.json) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_AUTH_TOKEN=

# --- Modelo / chat ---
# CTBZ_DEFAULT_MODEL=claude-opus-4-7
# CTBZ_MAX_HISTORY_TURNS=20

# --- Paths (defaults sensatos) ---
# CTBZ_HOME=~/.ctbz                  # estado/cache/canais
# CTBZ_WORK_DIR=                     # sandbox de read_file/shell_sandbox (default: cwd)
# CTBZ_TASKS_DIR=                    # filas .md (default: <WORK_DIR>/ctbz_tasks)

# --- Segurança das tools ---
# CTBZ_SHELL_ALLOWLIST=node,npm,npx,git,python,python3,pwd,echo
# CTBZ_HTTP_ALLOWLIST=docs.anthropic.com,platform.openai.com,ai.google.dev,docs.perplexity.ai,github.com,raw.githubusercontent.com,developer.mozilla.org
# CTBZ_QUEUE_VERIFY_SHELL=0          # =1 permite verify via shell (pipes/&&) — opt-in

# --- Camada confidencial (read_confidencial) ---
# CTBZ_CONFIDENCIAL_DIR=$HOME/internal_docs
# CTBZ_CONFIDENCIAL_FILES=relatorioA.json,relatorioB.json

# --- Briefing agent: contexto extra (não versionar o conteúdo real) ---
# CTBZ_BRIEFING_CONTEXT_FILE=$HOME/.config/ctbz/briefing_local.md
# CTBZ_BRIEFING_CONTEXT=

# --- Mentions Observatory (opcional) ---
# CTBZ_BRAND_PRIMARY=YourBrand
# CTBZ_BRAND_COMPETITORS=Beta,Gamma,Delta
# CTBZ_OBSERVATORY_PROMPTS_FILE=$HOME/.config/ctbz/prompts.json
# CTBZ_OBSERVATORY_DELAY_MS=500
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# PERPLEXITY_API_KEY=
